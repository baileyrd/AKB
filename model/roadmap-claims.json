{
  "schema_version": "1.0.0",
  "description": "Machine-checkable definition of done for every ROADMAP.md item. Enforced by tests/test_roadmap_claims.py: every roadmap item must appear here, and every checked item's assertions must currently hold. Unchecked items carry their assertions as the gate for ticking the box later.",
  "assertion_types": {
    "path_exists": "path (repo-relative file or directory) exists",
    "doc_exists": "docs/<doc> exists",
    "min_lines": "path has at least lines lines",
    "min_docs_in_volume": "at least count docs carry frontmatter volume: volume",
    "term_in_volume": "term appears (case-insensitive) in at least min_files docs of that volume",
    "term_in_docs": "term appears in at least min_files docs repo-wide, excluding CHARTER-DRIFT-ASSESSMENT.md",
    "min_graph_entities_of_kind": "composed graph has at least count entities of kind",
    "min_inventory_entities_of_kind": "model/inventory/current.json has at least count entities of kind",
    "explorer_view_nonempty": "the named tools/build_explorer.py view resolves to at least one entity",
    "min_observed_packages": "generated/coverage-assessment.json package_payload_coverage.observed_packages >= count"
  },
