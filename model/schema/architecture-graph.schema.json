{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.example/schema/msys2-akb/architecture-graph.schema.json",
  "title": "MSYS2 AKB Architecture Graph",
  "type": "object",
  "required": ["schema_version", "snapshot", "entities", "relationships"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"},
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"},
      "default": []
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9._/-]+:[a-z0-9._/@+-]+$"
    },
    "status": {
      "enum": [
        "unknown",
        "planned",
        "partial",
        "verified",
        "inferred",
        "deprecated",
        "superseded"
      ]
    },
    "confidence": {
      "enum": ["unknown", "low", "medium", "high", "verified"]
    },
    "snapshot": {
      "type": "object",
      "required": ["id", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "description": {"type": "string"},
        "upstream_versions": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "kind", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "authority": {"type": "string"},
        "aliases": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "applicability": {
          "type": "object",
          "additionalProperties": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["id", "type", "source", "target", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "status": {"$ref": "#/$defs/status"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "scope": {"type": "string"},
        "condition": {"type": "string"},
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "subject", "statement", "classification", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "subject": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "classification": {"enum": ["fact", "observation", "inference"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "valid_from": {"type": ["string", "null"]},
        "valid_to": {"type": ["string", "null"]},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "class", "title", "locator", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {
          "enum": ["primary", "derived", "observed", "secondary", "inference"]
        },
        "title": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "upstream_version": {"type": ["string", "null"]},
        "integrity": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}

